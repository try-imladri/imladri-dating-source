{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imladri-personal-preview",
  "main": "src/edge.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": { "RENDER_COLD_START_GUARD": "true", "API_ORIGIN": "https://imladri-personal-pilot.onrender.com" },
  "env": {
    "candidate": {
      "name": "imladri-personal-candidate",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "RENDER_COLD_START_GUARD": "true", "API_ORIGIN": "", "READINESS_ONLY": "true", "RENDER_FAILOVER_MODE": "auto",
        "RENDER_FAILOVER_ORIGIN": "https://imladri-personal-live-api.onrender.com" },
      "services": [{ "binding": "API", "service": "imladri-personal-api" }]
    },
    "production": {
      "name": "imladri-personal",
      "workers_dev": false,
      "preview_urls": false,
      "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
      "routes": [
        { "pattern": "imladri.com/*", "zone_name": "imladri.com" },
        { "pattern": "www.imladri.com/*", "zone_name": "imladri.com" }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": { "RENDER_COLD_START_GUARD": "true", "API_ORIGIN": "", "RENDER_FAILOVER_MODE": "auto",
        "RENDER_FAILOVER_ORIGIN": "https://imladri-personal-live-api.onrender.com" },
      "services": [{ "binding": "API", "service": "imladri-personal-api" }]
    },
    "container": {
      "name": "imladri-personal",
      "workers_dev": false,
      "preview_urls": false,
      "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
      "vars": { "RENDER_COLD_START_GUARD": "true", "API_ORIGIN": "", "RENDER_FAILOVER_MODE": "auto",
        "RENDER_FAILOVER_ORIGIN": "https://imladri-personal-live-api.onrender.com" },
      "routes": [
        { "pattern": "imladri.com/*", "zone_name": "imladri.com" },
        { "pattern": "www.imladri.com/*", "zone_name": "imladri.com" }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "services": [{ "binding": "API", "service": "imladri-personal-api" }]
    }
  }
}
