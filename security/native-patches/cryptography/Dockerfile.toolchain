FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cargo pkg-config libffi-dev perl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /build-env \
    && /build-env/bin/pip install --no-cache-dir pip==26.2 maturin==1.14.1 cffi==2.1.1 setuptools wheel \
       pytest==9.2.0 pytest-xdist==3.8.0 pytest-benchmark pytest-cov pretend certifi==2026.10.23 \
       cryptography_vectors==50.0.2 bcrypt==4.1.3 \
    && /build-env/bin/pip freeze --all > /build-tools-freeze.txt
ENV PATH=/build-env/bin:/usr/local/bin:/usr/bin:/bin CARGO_BUILD_JOBS=2 PIP_NO_CACHE_DIR=1
WORKDIR /work
